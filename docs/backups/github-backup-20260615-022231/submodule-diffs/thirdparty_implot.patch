diff --git a/implot.cpp b/implot.cpp
index 6753a2e..ad78f81 100644
--- a/implot.cpp
+++ b/implot.cpp
@@ -911,6 +911,17 @@ ImPlotTime MkGmtTime(struct tm *ptm) {
     ImPlotTime t;
 #ifdef _WIN32
     t.S = _mkgmtime(ptm);
+#elif defined(__SWITCH__)
+    const int year = ptm->tm_year + 1900;
+    const int month = ptm->tm_mon + 1;
+    const int day = ptm->tm_mday;
+    const int64_t adjusted_year = year - (month <= 2 ? 1 : 0);
+    const int64_t era = (adjusted_year >= 0 ? adjusted_year : adjusted_year - 399) / 400;
+    const unsigned yoe = static_cast<unsigned>(adjusted_year - era * 400);
+    const unsigned doy = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+    const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    const int64_t days = era * 146097 + static_cast<int64_t>(doe) - 719468;
+    t.S = static_cast<time_t>(days * 86400 + ptm->tm_hour * 3600 + ptm->tm_min * 60 + ptm->tm_sec);
 #else
     t.S = timegm(ptm);
 #endif
